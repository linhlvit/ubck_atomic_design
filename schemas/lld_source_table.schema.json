{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubck-atomic-design.local/schemas/lld_source_table.schema.json",
  "title": "LLD Source Table Schema",
  "description": "Schema cho file lld_{SOURCE}_{TABLE}.yaml — thiết kế LLD Level 1 per source table. Ghi vào DataModel/working/Atomic/lld/{SOURCE}/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_type", "schema_version", "metadata", "attributes"],
  "properties": {
    "schema_type": {
      "type": "string",
      "const": "lld_source_table",
      "description": "Phải là 'lld_source_table'"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Phiên bản schema"
    },
    "metadata": {
      "$ref": "#/definitions/lld_metadata"
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "description": "Danh sách attributes của entity (theo thứ tự thiết kế)",
      "items": {
        "$ref": "#/definitions/lld_attribute"
      }
    }
  },
  "definitions": {
    "lld_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "source_table",
        "atomic_entity",
        "entity_physical_name",
        "bcv_core_object",
        "group",
        "design_status"
      ],
      "properties": {
        "source_system": {
          "type": "string",
          "minLength": 2,
          "description": "Mã source system, VD: NHNCK, SCMS, FMS"
        },
        "source_table": {
          "type": "string",
          "minLength": 1,
          "description": "Tên bảng nguồn (không có prefix schema)"
        },
        "atomic_entity": {
          "type": "string",
          "minLength": 3,
          "description": "Tên Atomic entity đầy đủ (Title Case)"
        },
        "entity_physical_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Physical name của Atomic entity (snake_case) — dùng làm tên bảng Delta Lake"
        },
        "bcv_core_object": {
          "type": "string",
          "enum": [
            "Arrangement",
            "Business Activity",
            "Common",
            "Communication",
            "Condition",
            "Documentation",
            "Event",
            "Group",
            "Involved Party",
            "Location",
            "Product",
            "Transaction"
          ],
          "description": "BCV Core Object"
        },
        "bcv_concept": {
          "type": ["string", "null"],
          "description": "BCV Concept đầy đủ, VD: '[Condition] Fee Rate'"
        },
        "table_type": {
          "type": ["string", "null"],
          "enum": ["Fundamental", "Fact Append", "Fact Snapshot", "Relative", "Classification", null],
          "description": "Loại bảng Atomic"
        },
        "group": {
          "type": "string",
          "pattern": "^T[1-9]$",
          "description": "Tier dependency, VD: T1, T2, T3"
        },
        "design_status": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved"],
          "description": "Trạng thái thiết kế — approved = locked (skill không ghi đè)"
        },
        "version": {
          "type": ["string", "null"],
          "description": "Phiên bản thiết kế"
        },
        "designed_by": {
          "type": ["string", "null"],
          "description": "Email người thiết kế"
        },
        "designed_at": {
          "type": ["string", "null"],
          "description": "ISO 8601 timestamp"
        },
        "reviewed_by": {
          "type": ["string", "null"]
        },
        "reviewed_at": {
          "type": ["string", "null"]
        },
        "approved_by": {
          "type": ["string", "null"]
        },
        "approved_at": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"],
          "description": "Ghi chú tự do về thiết kế"
        }
      }
    },
    "lld_attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribute_name",
        "description",
        "data_domain",
        "nullable",
        "is_primary_key",
        "status",
        "source_columns"
      ],
      "properties": {
        "attribute_name": {
          "type": "string",
          "minLength": 2,
          "description": "Tên attribute (Title Case, chuẩn BCV)"
        },
        "physical_name": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Tên cột Delta Lake (snake_case)"
            }
          ]
        },
        "description": {
          "type": "string",
          "description": "Mô tả nghiệp vụ — tiếng Việt có dấu + mô tả nguồn (nếu có)"
        },
        "data_domain": {
          "type": "string",
          "enum": [
            "Text",
            "Date",
            "Timestamp",
            "Currency Amount",
            "Interest Rate",
            "Exchange Rate",
            "Percentage",
            "Surrogate Key",
            "Classification Value",
            "Indicator",
            "Boolean",
            "Small Counter",
            "Array<Text>",
            "Array<Struct>"
          ],
          "description": "Data domain chuẩn (12 + 2 extended)"
        },
        "nullable": {
          "type": "boolean",
          "description": "false nếu is_primary_key = true"
        },
        "is_primary_key": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved", "pending"],
          "description": "Per-attribute status — pending = chưa xác định FK target"
        },
        "source_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_.]*\\.[A-Za-z][A-Za-z0-9_.]*$",
            "description": "Format: SOURCE.schema.Table.Column (fully qualified)"
          },
          "description": "Danh sách cột nguồn (empty nếu surrogate/derived)"
        },
        "comment": {
          "type": ["string", "null"],
          "description": "FK target, Lookup pair, Scheme, BCV notes"
        },
        "classification_context": {
          "type": ["string", "null"],
          "description": "SCHEME=VALUE format, VD: SOURCE_SYSTEM=NHNCK.TABLE, IP_ELEC_ADDR_TYPE=PHONE"
        },
        "etl_derived_value": {
          "type": ["string", "null"],
          "description": "Giá trị hardcode ETL — bắt buộc khi classification_context = SCHEME=VALUE"
        },
        "data_type": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ],
          "description": "Kiểu dữ liệu Delta Lake (VD: string, bigint, date, decimal(18,2)) — auto-patch bởi transform_physical_names.py"
        }
      }
    }
  }
}
