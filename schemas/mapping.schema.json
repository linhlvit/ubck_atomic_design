{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubck-atomic-design.local/schemas/mapping.schema.json",
  "title": "Mapping Design Schema",
  "description": "Schema định nghĩa định dạng YAML cho Mapping spec — ánh xạ từ Bronze source table sang Atomic entity. Dùng để validate và parse các file mapping_atm_*.yaml trong thư mục Mapping/Atomic/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_type",
    "schema_version",
    "mapping",
    "target",
    "input",
    "relationship",
    "mapping_columns",
    "final_filter"
  ],
  "properties": {
    "schema_type": {
      "type": "string",
      "const": "mapping",
      "description": "Khai báo loại schema — dùng để xác định file type"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Phiên bản schema (semantic versioning)"
    },
    "mapping": {
      "$ref": "#/definitions/mapping_header"
    },
    "target": {
      "$ref": "#/definitions/target"
    },
    "input": {
      "type": "array",
      "minItems": 1,
      "description": "Danh sách bảng/CTE nguồn (physical_table, derived_cte, unpivot_cte)",
      "items": {
        "$ref": "#/definitions/input_source"
      }
    },
    "relationship": {
      "type": "array",
      "description": "Danh sách JOIN giữa các bảng/CTE nguồn. Để trống [] nếu không có JOIN.",
      "items": {
        "$ref": "#/definitions/relationship_item"
      }
    },
    "mapping_columns": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "description": "Danh sách mapping cột cho pattern regular",
          "items": {
            "$ref": "#/definitions/mapping_column"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "transformation_rules_ref": {
      "type": "string",
      "description": "Đường dẫn tương đối đến file shared transformation rules. Mặc định: Mapping/rules/transformation_rules.yaml"
    },
    "final_filter": {
      "type": "array",
      "description": "Danh sách mệnh đề WHERE / UNION ALL cuối transform. Để trống [] nếu không có.",
      "items": {
        "$ref": "#/definitions/final_filter_item"
      }
    }
  },
  "definitions": {
    "mapping_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "logical_name",
        "physical_name",
        "dm_ref",
        "brd_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MAP-ATM-[a-z][a-z0-9_]*-[A-Za-z][A-Za-z0-9_.]*$",
          "description": "Định danh duy nhất: MAP-ATM-{physical_name}-{SOURCE}.{TABLE}"
        },
        "logical_name": {
          "type": "string",
          "minLength": 10,
          "description": "Tên đầy đủ — thường là 'Mapping Atomic - {Entity} – source {SOURCE}.{TABLE}'"
        },
        "physical_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Tên bảng Atomic đích (snake_case)"
        },
        "dm_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^ATM-[a-z][a-z0-9_]*-[A-Za-z][A-Za-z0-9_.]*$",
              "description": "Tham chiếu đến DM YAML id — single source"
            },
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^ATM-[a-z][a-z0-9_]*-[A-Za-z][A-Za-z0-9_.]*$"
              },
              "description": "Tham chiếu đến nhiều DM YAML id — multi-source shared entity"
            }
          ]
        },
        "brd_ref": {
          "type": "string",
          "pattern": "^BRD-SRC-[A-Za-z][A-Za-z0-9_-]*-[A-Za-z][A-Za-z0-9_]*$",
          "description": "Tham chiếu BRD entry tương ứng"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "physical_name",
        "etl_handle",
        "description"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "const": "atomic",
          "description": "Namespace đích — luôn là 'atomic'"
        },
        "physical_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Tên bảng Atomic đích (snake_case) — dùng cho ETL job generation"
        },
        "etl_handle": {
          "type": "string",
          "enum": [
            "SCD4A",
            "SCD2",
            "Fact Append",
            "Upsert"
          ],
          "description": "ETL handle — định nghĩa cách xử lý dữ liệu trên Atomic (SCD4A/SCD2 cho dimension, Fact Append cho fact, Upsert cho classification value)"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "description": "Mô tả nghiệp vụ của mapping"
        }
      }
    },
    "input_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "table_name",
        "alias",
        "select_fields"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "physical_table",
            "derived_cte",
            "unpivot_cte"
          ],
          "description": "Loại nguồn: physical_table (bảng ODS thực tế), derived_cte (CTE tính toán), unpivot_cte (LATERAL VIEW stack)"
        },
        "namespace": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "ods"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Namespace ODS — null nếu là CTE"
        },
        "table_name": {
          "type": "string",
          "minLength": 1,
          "description": "Tên bảng nguồn hoặc alias CTE đầu vào"
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Alias dùng trong query"
        },
        "select_fields": {
          "type": "string",
          "minLength": 1,
          "description": "Danh sách cột select từ bảng/CTE này"
        },
        "filter": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Điều kiện filter (WHERE) hoặc GROUP BY. Null nếu không có."
        },
        "note": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Ghi chú bổ sung về input source"
        },
        "unpivot_spec": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/unpivot_spec"
            }
          ],
          "description": "Đặc tả UNPIVOT — chỉ dùng khi source_type = unpivot_cte. Null cho physical_table và derived_cte."
        }
      }
    },
    "unpivot_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_columns",
        "type_column",
        "legs"
      ],
      "description": "Đặc tả cấu trúc UNPIVOT/LATERAL VIEW — ETL generator dùng để sinh SQL tương ứng",
      "properties": {
        "value_columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Danh sách tên cột đích sau unpivot (theo thứ tự tương ứng với source_columns trong mỗi leg). VD: [identn_nbr, issu_dt, issu_ahr_nm]"
        },
        "type_column": {
          "type": "string",
          "minLength": 1,
          "description": "Tên cột phân loại sinh ra sau unpivot — chứa type_value của từng leg. VD: identn_tp_code"
        },
        "legs": {
          "type": "array",
          "minItems": 2,
          "description": "Danh sách legs — mỗi leg là 1 nhóm cột nguồn ánh xạ thành 1 loại bản ghi",
          "items": {
            "$ref": "#/definitions/unpivot_leg"
          }
        }
      }
    },
    "unpivot_leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_value",
        "source_columns"
      ],
      "properties": {
        "type_value": {
          "type": "string",
          "minLength": 1,
          "description": "Giá trị của type_column cho leg này — thường là Classification Value code. VD: BUSINESS_LICENSE"
        },
        "source_columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Danh sách cột nguồn tương ứng với value_columns (cùng thứ tự). VD: [IdNo, IdDate, IdAdd]"
        }
      }
    },
    "relationship_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_alias",
        "join_type",
        "join_alias",
        "join_on"
      ],
      "properties": {
        "main_alias": {
          "type": "string",
          "description": "Alias của bảng/CTE chính (left side)"
        },
        "join_type": {
          "type": "string",
          "enum": [
            "INNER JOIN",
            "LEFT JOIN",
            "RIGHT JOIN",
            "FULL OUTER JOIN"
          ],
          "description": "Loại JOIN"
        },
        "join_alias": {
          "type": "string",
          "description": "Alias của bảng/CTE JOIN vào (right side)"
        },
        "join_on": {
          "type": "string",
          "minLength": 1,
          "description": "Điều kiện JOIN"
        }
      }
    },
    "mapping_column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_column",
        "transformation",
        "data_type",
        "description"
      ],
      "properties": {
        "target_column": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Tên cột Atomic đích (snake_case)"
        },
        "transformation": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Biểu thức transformation. Null nếu chưa xác định."
        },
        "data_type": {
          "type": "string",
          "enum": [
            "string",
            "date",
            "timestamp",
            "boolean",
            "int",
            "decimal(23,2)",
            "decimal(5,2)",
            "decimal(8,5)",
            "array<string>",
            "array<struct<...>>"
          ],
          "description": "Kiểu dữ liệu đích (Delta Lake / Spark)"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Mô tả nghiệp vụ của cột"
        },
        "target_attr_name": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Tên thuộc tính Atomic đích (title case) — lấy từ trường name trong Model YAML tương ứng"
        }
      }
    },
    "final_filter_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_type",
        "expression"
      ],
      "properties": {
        "clause_type": {
          "type": "string",
          "enum": [
            "WHERE",
            "UNION ALL",
            "GROUP BY",
            "HAVING",
            "ORDER BY"
          ],
          "description": "Loại mệnh đề"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "description": "Nội dung mệnh đề"
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Mô tả mục đích"
        }
      }
    }
  }
}