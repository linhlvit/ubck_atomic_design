// Atomic Lakehouse — MDDS

Project MDDS {
  database_type: "Delta Lake"
  Note: "Atomic Lakehouse — MDDS"
}

Table "security_match_log" [note: "Log từng lần khớp lệnh (tick-by-tick) của cổ phiếu niêm yết trong ngày giao dịch, bao gồm giá khớp, khối lượng khớp, chiều giao dịch chủ động, và lũy kế khối lượng/giá trị từ đầu ngày."] {
  "security_match_log_id" varchar [pk]
}

Table "corporate_bond_trading_snapshot" [note: "Snapshot trạng thái giao dịch của trái phiếu doanh nghiệp niêm yết tại sàn HNX tại một thời điểm, bao gồm giá khớp, order book thỏa thuận Outright, thông tin đặc thù trái phiếu (kỳ hạn, lãi suất, coup"] {
  "corporate_bond_trading_snpst_id" varchar [pk]
}

Table "index_constituent_snapshot" [note: "Snapshot thành phần rổ chỉ số thị trường theo ngày giao dịch — mỗi dòng ghi nhận một cặp mã chỉ số và mã chứng khoán có mặt trong rổ chỉ số tại ngày giao dịch tương ứng."] {
  "index_constituent_snpst_id" varchar [pk]
}

Table "market_index_snapshot" [note: "Snapshot trạng thái của một chỉ số thị trường (VNINDEX, HNX-Index, UPCOM-Index) tại một thời điểm trong ngày, bao gồm điểm chỉ số, tổng khối lượng/giá trị, thống kê mã tăng/giảm/trần/sàn, trạng thái p"] {
  "market_index_snpst_id" varchar [pk]
}

Table "market_price_snapshot" [note: "Nến giá OHLCV (mở/cao/thấp/đóng cửa, khối lượng khớp) của một mã (chứng khoán hoặc chỉ số) theo kỳ phút hoặc ngày, phục vụ biểu đồ TradingView. Gộp từ 2 bảng nguồn cấu trúc gần như giống hệt nhau, phâ"] {
  "market_price_snpst_id" varchar [pk]
}

Table "security_trading_snapshot" [note: "Snapshot trạng thái giao dịch của một công cụ tài chính (cổ phiếu, chứng quyền, hợp đồng phái sinh, chứng chỉ quỹ) tại một thời điểm trong ngày giao dịch, bao gồm giá, sổ lệnh, NĐTNN và thông tin đặc "] {
  "security_trading_snpst_id" varchar [pk]
}

