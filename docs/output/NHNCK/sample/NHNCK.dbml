// Atomic Lakehouse — NHNCK

Project NHNCK {
  database_type: "Delta Lake"
  Note: "Atomic Lakehouse — NHNCK"
}

Table "scr_prac_conduct_vln" [note: "Vi phạm pháp luật hoặc hành chính của người hành nghề chứng khoán được ghi nhận kèm quyết định xử lý. Mỗi dòng = 1 sự kiện vi phạm insert-only. FK đến Practitioner và Decision."] {
  "scr_prac_conduct_vln_id" varchar [pk]
  "scr_prac_id" varchar
  "license_dcsn_doc_id" varchar
}

Table "scr_prac_prof_trn_clss_enrollment" [note: "Đăng ký tham gia và kết quả học tập của người hành nghề tại một khóa đào tạo chuyên môn. Ghi nhận điểm thi, kết quả đạt/không đạt và trạng thái ghi danh."] {
  "scr_prac_prof_trn_clss_enrollment_id" varchar [pk]
  "scr_prac_prof_trn_clss_id" varchar
  "scr_prac_id" varchar
  "perm_rsdnc_cty_id" varchar
  "perm_rsdnc_prov_id" varchar
  "perm_rsdnc_dstc_id" varchar
  "assignee_ofcr_id" varchar
  "crt_by_ofcr_id" varchar
  "udt_by_ofcr_id" varchar
}

