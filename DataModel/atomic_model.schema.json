{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atomic_model.schema.json",
  "title": "Atomic Model",
  "description": "Consolidated Atomic layer data model — entities with attributes and multi-source mappings.",
  "type": "object",
  "required": ["schema_type", "schema_version", "entities"],
  "additionalProperties": false,
  "properties": {
    "schema_type": {
      "type": "string",
      "const": "atomic_model"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    }
  },

  "$defs": {

    "entity": {
      "type": "object",
      "required": ["ldm", "attributes"],
      "additionalProperties": false,
      "properties": {
        "ldm": { "$ref": "#/$defs/ldm" },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attribute" }
        }
      }
    },

    "ldm": {
      "type": "object",
      "required": [
        "id",
        "logical_name_1st", "physical_name_1st", "layer_1st", "version_1st",
        "status_1st", "description_1st", "owner_1st",
        "bcv_core_object_most", "bcv_concept_most",
        "table_type_most", "etl_pattern_most",
        "conflict_review", "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique entity ID. Format: ATM-{physical_name}.",
          "pattern": "^ATM-[a-z][a-z0-9_-]*$"
        },
        "logical_name_1st": {
          "type": "string",
          "description": "Human-readable entity name in Title Case — from first source file.",
          "minLength": 1
        },
        "physical_name_1st": {
          "type": "string",
          "description": "Snake_case table name — from first source file.",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "layer_1st": {
          "type": "string",
          "const": "Atomic"
        },
        "version_1st": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "status_1st": {
          "type": "string",
          "enum": ["draft", "approved"]
        },
        "description_1st": {
          "type": "string",
          "minLength": 1
        },
        "owner_1st": { "$ref": "#/$defs/owner" },
        "bcv_core_object_most": {
          "type": "string",
          "description": "Most common bcv_core_object across source files.",
          "enum": [
            "Arrangement",
            "Business Activity",
            "Common",
            "Communication",
            "Condition",
            "Documentation",
            "Event",
            "Group",
            "Involved Party",
            "Location",
            "Product",
            "Transaction"
          ]
        },
        "bcv_concept_most": {
          "type": "string",
          "description": "Most common bcv_concept across source files.",
          "pattern": "^(\\[.+\\]( .+)?|ETL Pattern.+|Junction|Shared Entity)$"
        },
        "table_type_most": {
          "type": "string",
          "description": "Most common table_type across source files.",
          "enum": ["Fundamental", "Relative", "Classification", "Fact Append", "Fact Snapshot"]
        },
        "etl_pattern_most": {
          "type": "string",
          "description": "Most common etl_pattern across source files.",
          "enum": ["SCD4A", "SCD2", "Upsert", "Fact Append", "Fact Snapshot"]
        },
        "conflict_review": {
          "type": ["string", "null"],
          "description": "Conflict description for entity-level technical fields (logical_name, physical_name, layer, version, status, bcv_core_object, bcv_concept, table_type, etl_pattern). Null if all consistent."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_system_code" },
          "description": "Distinct source systems this entity consolidates from."
        },
        "references": { "$ref": "#/$defs/references" }
      }
    },

    "owner": {
      "type": "object",
      "required": ["steward", "data_modeler"],
      "additionalProperties": false,
      "properties": {
        "steward": {
          "type": "string",
          "format": "email"
        },
        "data_modeler": {
          "type": "string",
          "format": "email"
        }
      }
    },

    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brd": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "BRD reference ID. Format: BRD-SRC-{SOURCE}-{TABLE}.",
            "pattern": "^BRD-"
          }
        }
      }
    },

    "attribute": {
      "type": "object",
      "required": [
        "name", "physical_name",
        "business_meaning_1st", "comment_1st",
        "data_domain_most", "data_type_most",
        "nullable_most", "is_primary_key_most",
        "etl_derived_value", "conflict_review",
        "source_mappings"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Logical attribute name in Title Case.",
          "minLength": 1
        },
        "physical_name": {
          "type": "string",
          "description": "Snake_case column name (hyphens allowed for legacy names).",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "business_meaning_1st": {
          "type": "string",
          "description": "Business meaning from the first occurrence across source files.",
          "minLength": 1
        },
        "comment_1st": {
          "type": ["string", "null"],
          "description": "Comment from the first occurrence across source files."
        },
        "data_domain_most": {
          "type": "string",
          "description": "Most common data_domain across source occurrences.",
          "enum": [
            "Surrogate Key",
            "Text",
            "Classification Value",
            "Date",
            "Timestamp",
            "Currency Amount",
            "Interest Rate",
            "Exchange Rate",
            "Percentage",
            "Indicator",
            "Boolean",
            "Small Counter",
            "Array<Text>",
            "Array<Struct>"
          ]
        },
        "data_type_most": {
          "type": "string",
          "description": "Most common physical data type across source occurrences.",
          "anyOf": [
            { "enum": ["string", "boolean", "date", "timestamp", "int"] },
            { "pattern": "^decimal\\(\\d+,\\d+\\)$" },
            { "enum": ["array<string>"] },
            { "pattern": "^array<struct<.+>>$" }
          ]
        },
        "nullable_most": {
          "type": "boolean",
          "description": "Most common nullable value across source occurrences."
        },
        "is_primary_key_most": {
          "type": "boolean",
          "description": "Most common is_primary_key value across source occurrences."
        },
        "etl_derived_value": {
          "description": "Hardcoded or derived ETL value(s). Array when multiple distinct values across sources; scalar when single; null when none.",
          "oneOf": [
            { "type": ["string", "boolean", "integer", "null"] },
            {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string" }
            }
          ]
        },
        "conflict_review": {
          "type": ["string", "null"],
          "description": "Conflict description for technical fields (data_domain, data_type, nullable, is_primary_key) across source occurrences. Null if all consistent."
        },
        "source_mappings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_mapping" }
        }
      }
    },

    "source_mapping": {
      "type": "object",
      "required": ["source_system", "source_tables"],
      "additionalProperties": false,
      "properties": {
        "source_system": { "$ref": "#/$defs/source_system_code" },
        "source_tables": {
          "type": "array",
          "minItems": 1,
          "description": "All source tables within this source system that map to this attribute.",
          "items": {
            "type": "object",
            "required": ["source_table", "source_column"],
            "additionalProperties": false,
            "properties": {
              "source_table": {
                "type": "string",
                "description": "Source table name (unqualified).",
                "minLength": 1
              },
              "source_column": {
                "type": ["string", "null"],
                "description": "Fully-qualified source column: {SOURCE}.schema.{TABLE}.{COLUMN}, or null for derived/surrogate fields."
              },
              "business_meaning": {
                "type": ["string", "null"],
                "description": "Business meaning specific to this source table."
              },
              "comment": {
                "type": ["string", "null"],
                "description": "Comment specific to this source table."
              }
            }
          }
        }
      }
    },

    "source_system_code": {
      "type": "string",
      "enum": [
        "ECAT",
        "FIMS",
        "FMS",
        "GSGD",
        "IDS",
        "KNT",
        "MDDS",
        "NHNCK",
        "OrderTrade",
        "QLRR",
        "SCMS",
        "TTHC",
        "ThanhTra"
      ]
    }
  }
}
