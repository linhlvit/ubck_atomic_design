  crt_by_scms_usr_code varchar [note: 'Mã người tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến người cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người cập nhật bản ghi gần nhất.']
}

