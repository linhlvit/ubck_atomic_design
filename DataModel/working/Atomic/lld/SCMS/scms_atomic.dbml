}

Table sc_firm_related_person_ip_electronic_address [note: 'IP Electronic Address'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Related Person.']
  elec_addr_tp_code varchar [primary key, not null, note: 'Loại địa chỉ điện tử: PHONE=Điện thoại; EMAIL=Email.']
