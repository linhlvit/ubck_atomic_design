  prcs_unt varchar [note: 'Đơn vị xử lý đơn khiếu nại tố cáo.']
  sync_dt date [note: 'Ngày đồng bộ dữ liệu từ nguồn ngoài vào SCMS.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
