Table sc_firm_transaction_office [note: 'Securities Company Organization Unit'] {
  scr_co_org_unt_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_org_unt_code varchar [not null, note: 'Khóa chính kỹ thuật (ID tự tăng). BK của entity.']
