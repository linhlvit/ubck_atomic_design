Table sc_firm_info_ip_postal_address [note: 'Involved Party Postal Address'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company (Involved Party).']
  ip_code varchar [not null, note: 'Mã Securities Company.']
  addr_type_code varchar [primary key, not null, note: 'Loại địa chỉ.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  street_addr varchar [note: 'Địa chỉ trụ sở chính (số nhà, tên đường).']
