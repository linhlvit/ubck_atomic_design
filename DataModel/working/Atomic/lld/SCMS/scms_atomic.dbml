  dcsn_nbr varchar [note: 'Số quyết định cấp phép/chấp thuận phòng giao dịch.']
  dcsn_nbr_sec varchar [note: 'Số quyết định (trường mới DECISION_NUMBER — có thể trùng SO_QUYET_DINH).']
  dcsn_dt date [note: 'Ngày ban hành quyết định.']
  dcsn_dt_sec date [note: 'Ngày quyết định (trường mới DECISION_DATE — có thể trùng NGAY_QUYET_DINH).']
  doc_nbr varchar [note: 'Số văn bản pháp lý (QĐ/GP/CV/Thông tư).']
  doc_dt date [note: 'Ngày ký/ban hành văn bản.']
  doc_file_path varchar [note: 'Đường dẫn file văn bản.']
  doc_decl_ind boolean [note: 'Cờ khai theo văn bản.']
  vld_dssr_dt date [note: 'Ngày hồ sơ hợp lệ.']
  ofcl_oprtn_dt date [note: 'Ngày bắt đầu hoạt động chính thức.']
  vldty_strt_dt date [note: 'Ngày bắt đầu hiệu lực.']
  vldty_end_dt date [note: 'Ngày hết hiệu lực.']
  rprs_nm varchar [note: 'Họ tên người đại diện phòng giao dịch.']
  rprs_id varchar [note: 'ID nhân sự người đại diện (liên kết nội bộ SCMS, không phải FK chính thức).']
  attch_path varchar [note: 'Đường dẫn file đính kèm trên hệ thống lưu trữ.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
  crt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
}

Table sc_firm_transaction_office_ip_electronic_address [note: 'IP Electronic Address'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Organization Unit (phòng giao dịch CTCK).']
  elec_addr_tp_code varchar [primary key, not null, note: 'Loại địa chỉ điện tử: PHONE=Điện thoại; FAX=Fax.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  elec_addr_val varchar [note: 'Giá trị địa chỉ điện tử (số điện thoại / số fax).']
}

Table sc_firm_transaction_office_ip_postal_address [note: 'IP Postal Address'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Organization Unit (phòng giao dịch CTCK).']
  addr_tp_code varchar [primary key, not null, note: 'Loại địa chỉ: HEAD_OFFICE=Địa điểm phòng giao dịch.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  strt_addr varchar [note: 'Địa chỉ chi tiết của phòng giao dịch.']
  prov_geo_area_id varchar [note: 'FK đến Geographic Area cấp Tỉnh/Thành phố.']
  prov_geo_area_code varchar [note: 'Mã Tỉnh/Thành phố.']
  dist_geo_area_id varchar [note: 'FK đến Geographic Area cấp Quận/Huyện.']
  dist_geo_area_code varchar [note: 'Mã Quận/Huyện.']
  ward_geo_area_id varchar [note: 'FK đến Geographic Area cấp Phường/Xã.']
  ward_geo_area_code varchar [note: 'Mã Phường/Xã.']
}

Table sc_firm_branch_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Branch.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ định danh: OPERATION_LICENSE=Giấy phép hoạt động chi nhánh.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số giấy phép hoạt động chi nhánh.']
  issue_dt date [note: 'Ngày cấp giấy phép hoạt động chi nhánh.']
}

Table sc_firm_domestic_rep_office_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Domestic Representative Office.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ định danh: OPERATION_LICENSE=Giấy phép kinh doanh của văn phòng.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số giấy phép kinh doanh của văn phòng đại diện trong nước.']
  issue_dt date [note: 'Ngày cấp giấy phép kinh doanh.']
}

Table sc_firm_foreign_rep_office_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Foreign Representative Office.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ định danh: OPERATION_LICENSE=Giấy phép hoạt động VPDD tại VN; ENTERPRISE_CODE=Mã số doanh nghiệp; TAX_CODE=Mã số thuế.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số giấy tờ định danh của VPDD nước ngoài theo từng loại.']
  issue_dt date [note: 'Ngày cấp giấy phép hoạt động (áp dụng cho OPERATION_LICENSE).']
}

Table sc_firm_foreign_rep_office_vn_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Foreign Representative Office in VN.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ định danh: OPERATION_LICENSE=Giấy phép thành lập và hoạt động (UBCKNN); ESTABLISHMENT_LICENSE=Giấy phép hoạt động văn phòng tại VN.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số giấy tờ định danh của VPDD-VN theo từng loại.']
  issue_dt date [note: 'Ngày cấp giấy tờ.']
  issue_plc varchar [note: 'Cơ quan/nơi cấp giấy tờ.']
}

Table sc_firm_info_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ định danh: OPERATION_LICENSE; ESTABLISHMENT_LICENSE; TAX_CODE; ENTERPRISE_CODE; CERTIFICATE; CUSTODIAN_CERT; CUSTODIAN_MEMBER_CERT.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số giấy tờ định danh của CTCK theo từng loại.']
  issue_dt date [note: 'Ngày cấp giấy tờ (áp dụng cho các loại có ngày cấp).']
  issue_plc varchar [note: 'Cơ quan/nơi cấp (áp dụng cho OPERATION_LICENSE và ESTABLISHMENT_LICENSE).']
}

Table sc_firm_ownership_relation_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Ownership Relation.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ định danh: ENTERPRISE_CODE=Mã số doanh nghiệp.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Mã số doanh nghiệp của tổ chức có quan hệ sở hữu với CTCK.']
}

Table auditor_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Audit Firm Auditor.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ tùy thân: AUDITOR_CERT=Chứng chỉ hành nghề kiểm toán.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số chứng chỉ hành nghề kiểm toán.']
  issue_dt date [note: 'Ngày cấp chứng chỉ hành nghề.']
}

Table audit_firm_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Audit Firm.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ định danh tổ chức: BUSINESS_LICENSE=Giấy phép thành lập và hoạt động.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số giấy phép thành lập và hoạt động.']
  issue_dt date [note: 'Ngày cấp giấy phép.']
  issue_plc varchar [note: 'Nơi cấp giấy phép (mặc định: UBCKNN).']
}

Table bank_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Depositary Bank.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ định danh tổ chức: ENTERPRISE_CODE=Mã số doanh nghiệp; TAX_CODE=Mã số thuế; OPERATION_LICENSE=Giấy phép hoạt động ngân hàng; BIZ_REG_CERT=Giấy chứng nhận đăng ký kinh doanh.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số giấy tờ định danh của ngân hàng theo từng loại.']
  issue_dt date [note: 'Ngày cấp giấy tờ (áp dụng cho OPERATION_LICENSE và BIZ_REG_CERT).']
  issue_plc varchar [note: 'Tên cơ quan cấp (áp dụng cho OPERATION_LICENSE).']
}

Table custodian_bank_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Custodian Bank.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ định danh tổ chức: ESTABLISHMENT_LICENSE=Giấy phép thành lập ngân hàng; BIZ_REG_CERT=Giấy chứng nhận đăng ký kinh doanh.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số giấy tờ định danh của ngân hàng lưu ký theo từng loại.']
  issue_dt date [note: 'Ngày cấp giấy tờ.']
  issue_plc varchar [note: 'Nơi cấp giấy phép thành lập (áp dụng cho ESTABLISHMENT_LICENSE).']
}

Table sc_firm_foreign_branch_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Foreign Branch.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ định danh tổ chức: OPERATION_LICENSE=Giấy phép hoạt động tại Việt Nam; ENTERPRISE_CODE=Mã số doanh nghiệp; TAX_CODE=Mã số thuế; BIZ_REG_CERT=Giấy chứng nhận đăng ký doanh nghiệp.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số giấy tờ định danh của chi nhánh nước ngoài theo từng loại.']
  issue_dt date [note: 'Ngày cấp giấy tờ (áp dụng cho OPERATION_LICENSE và BIZ_REG_CERT).']
}

Table sc_firm_shareholder_relation_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Shareholder Relation.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ tùy thân: LEGACY_CMND=CMND cũ (ID_NUMBER).']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số CMND của người liên quan cổ đông.']
  issue_dt date [note: 'Ngày cấp CMND.']
  issue_plc varchar [note: 'Nơi cấp CMND.']
}

Table sc_firm_shareholder_representative_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Shareholder Representative.']
  id_tp_code varchar [primary key, not null, note: 'Loại giấy tờ tùy thân: LEGACY_CMND=CMND cũ (ID_NUMBER).']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  id_nbr varchar [note: 'Số CMND của người đại diện cổ đông.']
  issue_dt date [note: 'Ngày cấp CMND.']
  issue_plc varchar [note: 'Nơi cấp CMND.']
}

