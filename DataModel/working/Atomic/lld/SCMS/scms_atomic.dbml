Table sc_firm_shareholder [note: 'Securities Company Shareholder'] {
  scr_co_shrhdr_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_shrhdr_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán có cổ đông này.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  scr_co_snr_prsnl_id varchar [note: 'FK đến nhân sự cao cấp CTCK (nếu cổ đông cũng là nhân sự cao cấp).']
  scr_co_snr_prsnl_code varchar [note: 'Mã nhân sự cao cấp CTCK liên quan.']
  shrhdr_tp_code varchar [note: 'Loại cổ đông: CO_DONG_LON=Cổ đông lớn (≥5%); CO_DONG_SANG_LAP=Cổ đông sáng lậ...']
  shrhdr_ent_tp_code varchar [note: 'Loại hình cổ đông: CA_NHAN=Cá nhân; TO_CHUC_TRONG_NUOC=Tổ chức trong nước; TO...']
  rcrd_st_code varchar [note: 'Trạng thái bản ghi cổ đông: 1=Đang hoạt động/còn hiệu lực; 0=Ngừng hoạt động/...']
  ntlty_id varchar [note: 'FK đến quốc tịch của cổ đông.']
  ntlty_code varchar [note: 'Mã quốc tịch của cổ đông.']
  indvdl_ind boolean [note: 'Cờ là cá nhân: 1=Cá nhân; 0=Tổ chức.']
  shrhdr_nm varchar [note: 'Họ và tên đầy đủ (cá nhân) hoặc tên đầy đủ (tổ chức) của cổ đông.']
  dt_of_brth date [note: 'Ngày sinh (dd/mm/yyyy).']
  plc_of_brth varchar [note: 'Nơi sinh.']
  issue_dt date [note: 'Ngày cấp giấy tờ/chứng chỉ định danh.']
  issue_plc varchar [note: 'Nơi cấp giấy tờ/chứng chỉ định danh.']
  edu_lvl varchar [note: 'Trình độ học vấn của cổ đông cá nhân.']
  dgr varchar [note: 'Bằng cấp chuyên môn của cổ đông cá nhân.']
  ocptn varchar [note: 'Nghề nghiệp của cổ đông cá nhân.']
  wkplc varchar [note: 'Nơi làm việc của cổ đông cá nhân.']
  job_title varchar [note: 'Chức danh/chức vụ của cổ đông cá nhân tại nơi làm việc.']
  trdng_acct varchar [note: 'Số tài khoản giao dịch chứng khoán của cổ đông.']
  org_shrt_nm varchar [note: 'Tên viết tắt của tổ chức cổ đông.']
  lgl_rprsntv_nm varchar [note: 'Tên người đại diện pháp luật của tổ chức cổ đông.']
  rprsntv_pstn varchar [note: 'Chức vụ của người đại diện pháp luật của tổ chức cổ đông.']
  shrs_held integer [note: 'Số lượng cổ phần đang nắm giữ.']
  frly_trdbl_shrs integer [note: 'Số cổ phần tự do giao dịch.']
  plgd_shrs integer [note: 'Số cổ phần đang cầm cố/thế chấp.']
  rstrd_shrs integer [note: 'Số cổ phần bị hạn chế chuyển nhượng.']
  ownshp_ratio decimal [note: 'Tỷ lệ sở hữu vốn (%).']
  cntrd_cap decimal [note: 'Vốn góp (đơn vị: đồng).']
  lrg_shrhdr_dt date [note: 'Ngày đạt tỷ lệ sở hữu cổ đông lớn (từ 5% trở lên).']
  cntrlng_shrhdr varchar [note: 'Thông tin cổ đông kiểm soát.']
  fndng_shrhdr_ind boolean [note: 'Cờ là cổ đông sáng lập: 1=Có; 0=Không.']
  ownr_ind boolean [note: 'Cờ là chủ sở hữu.']
  prty_mmbr_ind boolean [note: 'Cờ là đảng viên.']
  lgl_ent_rprsntv_ind boolean [note: 'Cờ là người đại diện pháp luật.']
  co_emply_ind boolean [note: 'Cờ là nhân viên của CTCK.']
  frgn_invstmt_ind boolean [note: 'Cờ là vốn đầu tư nước ngoài: 1=Có; 0=Không.']
  prctnr_lgcy_id varchar [note: 'Mã tham chiếu người hành nghề từ hệ thống cũ.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi (tự động ghi nhận bởi hệ thống).']
  udt_tms timestamp [note: 'Thời điểm cập nhật lần cuối (tự động ghi nhận bởi hệ thống).']
  crt_by_scms_usr_id varchar [note: 'FK đến người tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến tài khoản người dùng cập nhật lần cuối.']
  udt_by_scms_usr_code varchar [note: 'Mã tài khoản người dùng cập nhật lần cuối.']
}

