Table disclosure_report [note: 'Securities Company Disclosure Report'] {
  scr_co_dscsr_rprt_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_dscsr_rprt_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán công bố thông tin.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  scr_co_prdc_rprt_id varchar [note: 'FK đến báo cáo định kỳ liên quan (nullable).']
  scr_co_prdc_rprt_code varchar [note: 'Mã báo cáo định kỳ.']
  scr_co_adhc_rprt_id varchar [note: 'FK đến báo cáo đột xuất liên quan (nullable).']
  scr_co_adhc_rprt_code varchar [note: 'Mã báo cáo đột xuất.']
  scr_co_frgn_brn_id varchar [note: 'FK đến chi nhánh CTCK nước ngoài liên quan (nullable).']
  scr_co_frgn_brn_code varchar [note: 'Mã chi nhánh CTCK nước ngoài.']
  orig_dscsr_rprt_id varchar [note: 'FK self-reference đến bản CBTT gốc (khi bản này là đính chính).']
  orig_dscsr_rprt_code varchar [note: 'Mã bản CBTT gốc.']
  mmbr_rprt_id varchar [note: 'FK đến báo cáo thành viên liên quan (MEMBER_REPORT).']
  dscsr_news_tp_code varchar [note: 'Loại tin công bố: 1=Định kỳ; 2=Bất thường; 3=Theo yêu cầu.']
  dscsr_chnl_tp_code varchar [note: 'Loại hình công bố: 1=CBTT trên sàn; 2=UBCKNN; 3=Trang web công ty.']
  rprt_prd_code varchar [note: 'Kỳ báo cáo (Ngày/Tuần/Tháng/Quý/Bán niên/Năm).']
  evt_tp_code varchar [note: 'FK đến loại sự vụ/sự kiện nghiệp vụ (CAT_EVENT_TYPE).']
  dscsr_st_code varchar [note: 'Trạng thái gửi CBTT từ hệ thống BA: 0=Chưa gửi; 1=Đã gửi thành công; -1=Lỗi k...']
  title varchar [note: 'Tiêu đề thông báo/tin nhắn/báo cáo.']
  descr varchar [note: 'Mô tả chi tiết nội dung/mục đích của bản ghi.']
  smry varchar [note: 'Tóm tắt nội dung trích yếu.']
  dscsr_prsn_nm varchar [note: 'Tên người công bố thông tin (denormalized).']
  rprt_yr varchar [note: 'Năm báo cáo CBTT.']
  rprt_prd_val varchar [note: 'Giá trị kỳ báo cáo (VD: \'2024-Q1\', \'2024-06\').']
  crrctn_ind boolean [note: 'Cờ tin đính chính: 1=Đính chính; 0=Tin gốc.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  err_descr varchar [note: 'Mô tả lỗi khi gửi CBTT.']
  cncl_rsn varchar [note: 'Lý do hủy báo cáo.']
  rjctn_rsn varchar [note: 'Lý do từ chối báo cáo.']
  dscsr_dt date [note: 'Ngày công bố thông tin.']
  dscsr_ddln_tms timestamp [note: 'Thời hạn phải công bố thông tin.']
  late_days integer [note: 'Số ngày CBTT muộn.']
  attch_path varchar [note: 'Đường dẫn file đính kèm trên hệ thống lưu trữ.']
  evt_tms timestamp [note: 'Thời điểm xảy ra sự kiện CBTT.']
  sent_tms timestamp [note: 'Thời điểm gửi CBTT.']
  cncld_tms timestamp [note: 'Thời điểm hủy CBTT.']
  lgcy_news_id varchar [note: 'ID tin tức từ hệ thống cũ (legacy).']
  lgcy_filenm varchar [note: 'Tên file đính kèm từ hệ thống cũ.']
  frgn_brn_rprt_id varchar [note: 'ID báo cáo chi nhánh CTCK nước ngoài liên quan.']
  apprvd_by_scms_usr_id varchar [note: 'FK đến người phê duyệt CBTT.']
  apprvd_by_scms_usr_code varchar [note: 'Mã người phê duyệt CBTT.']
  sndr_scms_usr_id varchar [note: 'FK đến người gửi CBTT.']
  sndr_scms_usr_code varchar [note: 'Mã người gửi CBTT.']
  cncld_by_scms_usr_id varchar [note: 'FK đến người hủy CBTT.']
  cncld_by_scms_usr_code varchar [note: 'Mã người hủy CBTT.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi (tự động ghi nhận bởi hệ thống).']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
  crt_by_scms_usr_id varchar [note: 'FK đến người tạo bản ghi CBTT.']
  crt_by_scms_usr_code varchar [note: 'Mã người tạo bản ghi CBTT.']
  udt_by_scms_usr_id varchar [note: 'FK đến người cập nhật bản ghi CBTT gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người cập nhật bản ghi CBTT gần nhất.']
}

Table disclosure_securities_offering [note: 'Securities Company Disclosure Securities Offering'] {
  scr_co_dscsr_scr_ofrng_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
