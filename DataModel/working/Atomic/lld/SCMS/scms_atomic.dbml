  udt_by_scms_usr_id varchar [note: 'FK đến người cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người cập nhật bản ghi gần nhất.']
}

Table sc_firm_alert_violation [note: 'Securities Company Alert Violation'] {
  scr_co_alrt_vlt_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_alrt_vlt_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán có vi phạm cảnh báo.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  scr_co_alrt_indctr_id varchar [note: 'FK đến chỉ tiêu cảnh báo kích hoạt vi phạm.']
  scr_co_alrt_indctr_code varchar [note: 'Mã chỉ tiêu cảnh báo.']
  alrt_cndtn_id varchar [note: 'FK đến điều kiện cảnh báo (Alert Condition) liên quan.']
  alrt_cndtn_code varchar [note: 'Mã điều kiện cảnh báo.']
  alrt_run_id varchar [note: 'FK đến lần chạy alert tạo ra vi phạm này.']
  alrt_run_code varchar [note: 'Mã lần chạy alert.']
  vlt_svty_code varchar [note: 'Mức độ nghiêm trọng của vi phạm: 1=Nhẹ; 2=Trung bình; 3=Nghiêm trọng.']
  svty_lvl varchar [note: 'Nhãn mức độ nghiêm trọng dạng văn bản (tương ứng VIOLATION_SEVERITY nhưng dạn...']
  alrt_ent_tp_code varchar [note: 'Loại đối tượng cảnh báo: CTCK=Công ty chứng khoán; CN_NUOC_NGOAI=Chi nhánh nư...']
  alrt_ent_code varchar [note: 'Mã nghiệp vụ của đối tượng cảnh báo (tùy loại ENTITY_TYPE).']
  cndtn_exprn varchar [note: 'Biểu thức điều kiện logic đã kích hoạt cảnh báo.']
  cmpr_val integer [note: 'Giá trị so sánh dùng trong điều kiện cảnh báo.']
  actl_val decimal [note: 'Giá trị thực tế của chỉ số tại thời điểm cảnh báo.']
  thrshd_val decimal [note: 'Ngưỡng cảnh báo được cấu hình.']
  ddctd_scr decimal [note: 'Điểm trừ do vi phạm cảnh báo.']
  alrt_yr varchar [note: 'Năm của cảnh báo.']
  rprt_yr integer [note: 'Năm báo cáo liên quan đến cảnh báo.']
  rprt_prd_code varchar [note: 'Kỳ báo cáo của cảnh báo.']
  rprt_prd_val integer [note: 'Giá trị kỳ báo cáo (số thứ tự kỳ: quý 1/2/3/4 hoặc tháng 1-12).']
  prd varchar [note: 'Giai đoạn/kỳ của cảnh báo dạng chuỗi ký hiệu.']
  rslvd_ind boolean [note: 'Cờ đánh dấu vi phạm đã được xử lý: 1=Đã xử lý; 0=Chưa xử lý.']
  rsln_note varchar [note: 'Ghi chú về cách xử lý vi phạm cảnh báo.']
  vlt_dscptn varchar [note: 'Mô tả chi tiết về vi phạm cảnh báo.']
  note varchar [note: 'Ghi chú bổ sung về vi phạm cảnh báo.']
  prcs_dt timestamp [note: 'Thời điểm xử lý vi phạm cảnh báo.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  crt_by_scms_usr_id varchar [note: 'FK đến người dùng tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người dùng tạo bản ghi.']
  prcs_scms_usr_id varchar [note: 'FK đến người xử lý vi phạm cảnh báo.']
  prcs_scms_usr_code varchar [note: 'Mã người xử lý vi phạm cảnh báo.']
}

Table sc_firm_branch [note: 'Securities Company Organization Unit'] {
  scr_co_org_unt_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_org_unt_code varchar [not null, note: 'Khóa chính kỹ thuật (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  org_unt_tp_code varchar [not null, note: 'Loại đơn vị tổ chức trực thuộc CTCK.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán (đơn vị cha).']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  prn_org_unt_id varchar [note: 'FK tự tham chiếu — chi nhánh cha (nếu là chi nhánh cấp dưới).']
  prn_org_unt_code varchar [note: 'Mã đơn vị tổ chức cha.']
  org_unt_code varchar [note: 'Mã nghiệp vụ chi nhánh (mã viết tắt).']
  org_unt_nm varchar [note: 'Tên chi nhánh.']
  org_unt_lgcy_nm varchar [note: 'Tên chi nhánh (trường cũ BRANCH_NAME — có thể trùng với FULL_NAME).']
  org_unt_en_nm varchar [note: 'Tên chi nhánh bằng tiếng Anh.']
  lfc_st_code varchar [note: 'Trạng thái pháp lý chi nhánh — FK tới CAT_SC_FIRM_STATUS (Đang hoạt động, Tạm...']
  rcrd_st_code varchar [note: 'Trạng thái bản ghi kỹ thuật: 1=Đang hoạt động/còn hiệu lực; 0=Ngừng hoạt động...']
  prvsn_ind boolean [note: 'Cờ bản nháp: 1=Bản nháp; 0=Chính thức.']
  dcsn_nbr varchar [note: 'Số quyết định cấp phép/chấp thuận chi nhánh.']
  dcsn_dt date [note: 'Ngày ban hành quyết định.']
  vld_dssr_dt date [note: 'Ngày hồ sơ hợp lệ (ngày tiếp nhận hồ sơ hợp lệ).']
  oprtn_dt date [note: 'Ngày bắt đầu hoạt động (dự kiến).']
  ofcl_oprtn_dt date [note: 'Ngày bắt đầu hoạt động chính thức.']
  dir_nm varchar [note: 'Họ tên Giám đốc chi nhánh.']
  rprs_nm varchar [note: 'Họ tên người đại diện chi nhánh.']
  rprs_ttl varchar [note: 'Chức danh người đại diện chi nhánh.']
  prsn_dir_id varchar [note: 'ID nhân sự giám đốc (liên kết nội bộ SCMS, không phải FK chính thức).']
  adm_authr_nm varchar [note: 'Tên cơ quan cấp phép/quản lý chi nhánh (VD: UBCKNN, Sở KH).']
  biz_line_codes varchar[] [note: 'Danh sách nghiệp vụ kinh doanh chứng khoán được cấp phép cho chi nhánh.']
  attch_path varchar [note: 'Đường dẫn file đính kèm trên hệ thống lưu trữ.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
  crt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
}

Table sc_firm_branch_ip_electronic_address [note: 'IP Electronic Address'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Organization Unit (chi nhánh CTCK).']
  elec_addr_tp_code varchar [primary key, not null, note: 'Loại địa chỉ điện tử: PHONE=Điện thoại; FAX=Fax; EMAIL=Email; WEBSITE=Website.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  elec_addr_val varchar [note: 'Giá trị địa chỉ điện tử (số điện thoại / số fax / địa chỉ email / URL website).']
