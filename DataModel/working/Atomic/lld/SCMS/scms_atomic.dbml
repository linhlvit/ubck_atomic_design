Table sc_firm_info [note: 'Securities Company'] {
  scr_co_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_code varchar [not null, note: 'Khóa chính kỹ thuật (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  prn_scr_co_id varchar [note: 'FK tự tham chiếu — CTCK cha trong cấu trúc phân cấp (nếu có).']
  prn_scr_co_code varchar [note: 'Mã CTCK cha.']
  org_code varchar [note: 'Mã định danh (mã viết tắt, mã nghiệp vụ) của CTCK.']
  scr_co_shrt_nm varchar [note: 'Tên viết tắt (VD: SSI, VPS, MBS).']
  scr_co_nm varchar [note: 'Tên đầy đủ bằng tiếng Việt.']
  scr_co_en_nm varchar [note: 'Tên đầy đủ bằng tiếng Anh.']
  co_tp_code varchar [note: 'Loại hình doanh nghiệp CTCK (FK đến CAT_COMPANY_TYPE).']
  lfc_st_code varchar [note: 'Trạng thái pháp lý CTCK — FK tới CAT_SC_FIRM_STATUS (Đang hoạt động, Tạm ngừn...']
  evt_tp_code varchar [note: 'Loại sự vụ/sự kiện nghiệp vụ — FK tới CAT_EVENT_TYPE.']
  fin_rpt_tp_code varchar [note: 'Loại báo cáo tài chính: RIENG_LE=Riêng lẻ; HOP_NHAT=Hợp nhất (nhiều giá trị p...']
  biz_license varchar [note: 'Giấy phép kinh doanh (số/tên file).']
  fndtn_license_file_path varchar [note: 'Đường dẫn file giấy phép thành lập trên hệ thống lưu trữ.']
  dcsn_nbr varchar [note: 'Số quyết định phê duyệt/cấp phép.']
  license_expiry_dt date [note: 'Ngày hết hạn giấy phép.']
  termntn_dcsn_nbr varchar [note: 'Số quyết định chấm dứt hoạt động.']
  charter_cptl_amt decimal(23,2) [note: 'Vốn điều lệ (đơn vị: đồng).']
  tot_shrs varchar [note: 'Tổng số lượng cổ phần (tự động = vốn điều lệ / mệnh giá 10.000đ).']
  biz_line_codes varchar[] [note: 'Danh sách nghiệp vụ kinh doanh chứng khoán được cấp phép (denormalized từ LNK...']
  addnl_biz_line_codes varchar[] [note: 'Danh sách nghiệp vụ kinh doanh bổ sung được cấp phép.']
  listed_ind boolean [note: 'Cờ niêm yết: 1=Có niêm yết trên sàn; 0=Không niêm yết.']
  listing_xchg_code varchar [note: 'Sàn niêm yết (HOSE, HNX, UPCOM).']
  scr_code varchar [note: 'Mã chứng khoán niêm yết.']
  listing_dt date [note: 'Ngày niêm yết trên sàn giao dịch.']
  reg_dt date [note: 'Ngày đăng ký thành lập CTCK.']
  ofcl_oprtn_dt date [note: 'Ngày bắt đầu hoạt động chính thức.']
  fscl_yr_end_dt varchar [note: 'Ngày kết thúc năm tài chính (VD: 31/12).']
  elec_trd_st_code varchar [note: 'Trạng thái giao dịch điện tử: HOAT_DONG=Đang hoạt động; TAM_NGUNG=Tạm ngừng; ...']
  elec_trd_dcsn_nbr varchar [note: 'Số quyết định về giao dịch điện tử.']
  elec_trd_dcsn_dt date [note: 'Ngày quyết định về giao dịch điện tử.']
  elec_trd_rsn varchar [note: 'Lý do thay đổi trạng thái giao dịch điện tử.']
  pub_co_ind boolean [note: 'Cờ công ty đại chúng: 1=Là công ty đại chúng; 0=Không phải.']
  pub_co_reg_dt date [note: 'Ngày đăng ký là công ty đại chúng với UBCKNN.']
  pub_co_dcsn_nbr varchar [note: 'Số quyết định công ty đại chúng.']
  pub_co_end_dt date [note: 'Ngày chấm dứt tư cách công ty đại chúng.']
  pub_co_end_dcsn_nbr varchar [note: 'Số quyết định chấm dứt tư cách công ty đại chúng.']
  cstd_mmbr_code varchar [note: 'Mã thành viên lưu ký.']
  cstd_mmbr_revoc_dcsn varchar [note: 'Quyết định thu hồi tư cách thành viên lưu ký.']
  cstd_mmbr_revoc_dt date [note: 'Ngày thu hồi tư cách thành viên lưu ký.']
  frgn_invstr_own_lmt_rate decimal(9,4) [note: 'Tỷ lệ sở hữu tối đa của nhà đầu tư nước ngoài.']
  own_lmt_from_dt date [note: 'Ngày bắt đầu áp dụng giới hạn sở hữu nước ngoài.']
  own_lmt_to_dt date [note: 'Ngày kết thúc áp dụng giới hạn sở hữu nước ngoài.']
  amndmt_decl_ind boolean [note: 'Cờ có khai bổ sung/sửa đổi: 1=Có văn bản sửa đổi; 0=Không có.']
  amndmt_doc_nbr varchar [note: 'Số văn bản sửa đổi.']
  amndmt_doc_dt date [note: 'Ngày văn bản sửa đổi.']
  amndmt_eff_dt date [note: 'Ngày hiệu lực văn bản sửa đổi.']
  amndmt_expiry_dt date [note: 'Ngày hết hạn văn bản sửa đổi.']
  amndmt_doc_file_path varchar [note: 'Đường dẫn file văn bản sửa đổi.']
  prvsn_ind boolean [note: 'Cờ bản nháp: 1=Bản nháp; 0=Chính thức.']
  syncd_from_adm_proc_ind boolean [note: 'Cờ đã đồng bộ từ Thủ tục hành chính: 1=Đã đồng bộ; 0=Chưa đồng bộ.']
  attch_path varchar [note: 'Đường dẫn file đính kèm trên hệ thống lưu trữ.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi (tự động ghi nhận bởi hệ thống).']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất (tự động ghi nhận bởi hệ thống).']
  crt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
}

Table sc_firm_info_ip_electronic_address [note: 'Involved Party Electronic Address'] {
