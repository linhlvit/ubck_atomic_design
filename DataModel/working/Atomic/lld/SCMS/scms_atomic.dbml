  dist_geo_area_code varchar [note: 'Mã Quận/Huyện.']
  dist_nm varchar [note: 'Tên Quận/Huyện (denormalized text, không có FK riêng).']
  ward_geo_area_id varchar [note: 'FK đến Geographic Area cấp Phường/Xã.']
  ward_geo_area_code varchar [note: 'Mã Phường/Xã.']
