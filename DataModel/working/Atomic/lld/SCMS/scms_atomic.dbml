Table sc_firm_branch_ip_postal_address [note: 'IP Postal Address'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Organization Unit (chi nhánh CTCK).']
  addr_tp_code varchar [primary key, not null, note: 'Loại địa chỉ: HEAD_OFFICE=Trụ sở/địa điểm kinh doanh chính.']
