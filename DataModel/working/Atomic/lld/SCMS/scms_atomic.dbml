Table sc_firm_major_shareholder_relation [note: 'Securities Company Major Shareholder Relation'] {
  scr_co_mjr_shrhdr_rln_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_mjr_shrhdr_rln_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán có cổ đông lớn.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  shrhdr_ref_id varchar [note: 'Tham chiếu đến SC_FIRM_SHAREHOLDER.ID (không phải FK constraint).']
  indvdl_ind boolean [note: 'Cờ là cá nhân: 1=Cá nhân; 0=Tổ chức.']
  full_nm varchar [note: 'Họ và tên đầy đủ (cá nhân) hoặc tên đầy đủ (tổ chức).']
  issue_dt date [note: 'Ngày cấp giấy tờ/chứng chỉ định danh.']
  issue_plc varchar [note: 'Nơi cấp giấy tờ/chứng chỉ định danh.']
  ntlty_id varchar [note: 'FK đến quốc tịch của cổ đông lớn.']
  ntlty_code varchar [note: 'Mã quốc tịch của cổ đông lớn.']
  rltshp varchar [note: 'Mối quan hệ của cổ đông lớn với CTCK.']
  rln_strt_dt date [note: 'Ngày bắt đầu quan hệ cổ đông lớn.']
  rln_end_dt date [note: 'Ngày kết thúc quan hệ cổ đông lớn.']
  lrg_shrhdr_dt date [note: 'Ngày đạt tỷ lệ sở hữu cổ đông lớn (từ 5% trở lên).']
  ownshp_ratio decimal [note: 'Tỷ lệ sở hữu vốn (%).']
  shrs_cnt integer [note: 'Số lượng cổ phần nắm giữ.']
  cntrd_cap decimal [note: 'Vốn góp (đơn vị: đồng).']
  note varchar [note: 'Ghi chú bổ sung về cổ đông lớn.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
}

