  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  prn_org_unt_id varchar [note: 'FK đến chi nhánh cha (phòng giao dịch trực thuộc chi nhánh).']
  prn_org_unt_code varchar [note: 'Mã đơn vị tổ chức cha.']
