}

Table sc_firm_periodic_report [note: 'Securities Company Periodic Report'] {
  scr_co_prdc_rprt_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_prdc_rprt_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán nộp báo cáo.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  frm_rprt_id varchar [note: 'FK đến biểu mẫu báo cáo liên quan (FORM_REPORT).']
  rprt_nm varchar [note: 'Tên báo cáo/biểu mẫu.']
  rprt_yr integer [note: 'Năm báo cáo.']
  rprt_prd integer [note: 'Kỳ số (1-4 cho quý, 1-12 cho tháng).']
  rprt_qtr integer [note: 'Quý trong năm (1, 2, 3, 4).']
  rprt_mth integer [note: 'Tháng trong năm.']
  rprt_prd_code varchar [note: 'Kỳ báo cáo (Ngày/Tuần/Tháng/Quý/Bán niên/Năm).']
  strt_dt date [note: 'Ngày bắt đầu kỳ báo cáo hoặc hiệu lực.']
  end_dt date [note: 'Ngày kết thúc kỳ báo cáo hoặc hết hiệu lực.']
  sbmsn_ddln_dt date [note: 'Hạn nộp báo cáo theo quy định.']
  sbmsn_ddln_tms timestamp [note: 'Hạn nộp báo cáo theo quy định (có giờ).']
  rprt_sbmsn_st_code varchar [note: 'Trạng thái nộp báo cáo định kỳ: 0=Chưa gửi; 1=Đã gửi; 2=Đã duyệt; -1=Từ chối;...']
  ovrd_days integer [note: 'Số ngày nộp báo cáo quá hạn.']
  evt_tp_code varchar [note: 'FK đến loại sự vụ/sự kiện nghiệp vụ (CAT_EVENT_TYPE).']
  sent_tms timestamp [note: 'Thời điểm gửi báo cáo lên UBCKNN.']
  apprvd_tms timestamp [note: 'Thời điểm phê duyệt báo cáo.']
  cncld_tms timestamp [note: 'Thời điểm hủy báo cáo.']
  apprvd_by_scms_usr_id varchar [note: 'FK đến người phê duyệt báo cáo.']
  apprvd_by_scms_usr_code varchar [note: 'Mã người phê duyệt báo cáo.']
  sndr_scms_usr_id varchar [note: 'FK đến người gửi báo cáo.']
  sndr_scms_usr_code varchar [note: 'Mã người gửi báo cáo.']
  cncld_by_scms_usr_id varchar [note: 'FK đến người hủy báo cáo.']
  cncld_by_scms_usr_code varchar [note: 'Mã người hủy báo cáo.']
  vld_dgtl_sgn_ind boolean [note: 'Chữ ký số hợp lệ: 1=Hợp lệ; 0=Không hợp lệ.']
  vld_data_ind boolean [note: 'Dữ liệu hợp lệ (vượt qua kiểm tra nghiệp vụ): 1=Hợp lệ; 0=Không hợp lệ.']
  dgtl_sgn_file varchar [note: 'Đường dẫn file chữ ký số.']
  smry varchar [note: 'Tóm tắt nội dung trích yếu.']
  imprt_file_path varchar [note: 'Đường dẫn file Excel import dữ liệu.']
  attch_path varchar [note: 'Đường dẫn file đính kèm trên hệ thống lưu trữ.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  cncl_rsn varchar [note: 'Lý do hủy báo cáo.']
  rjctn_rsn varchar [note: 'Lý do từ chối báo cáo.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi (tự động ghi nhận bởi hệ thống).']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất (tự động ghi nhận bởi hệ thống).']
}

Table sc_firm_profile_change [note: 'Securities Company Profile Change'] {
  scr_co_prfl_chng_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_prfl_chng_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng hoặc UUID). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán liên quan đến thay đổi hồ sơ.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  prfl_chng_ent_tp_code varchar [note: 'Loại đối tượng bị thay đổi: CTCK=Công ty chứng khoán; CHI_NHANH=Chi nhánh; PH...']
  ent_id varchar [note: 'ID của đối tượng bị thay đổi (polymorphic — trỏ đến bảng khác nhau tuỳ theo E...']
  evt_tp_id varchar [note: 'FK đến loại sự vụ/sự kiện nghiệp vụ (loại thay đổi hồ sơ).']
  evt_tp_code varchar [note: 'Mã loại sự vụ/sự kiện nghiệp vụ.']
  evt_tp_nm varchar [note: 'Tên loại sự vụ/sự kiện nghiệp vụ (denormalized snapshot).']
  sbj_dsply_nm varchar [note: 'Tên hiển thị của đối tượng bị thay đổi (chuỗi mô tả ngắn).']
  bfr_info varchar [note: 'Thông tin hồ sơ trước khi thay đổi (dạng văn bản).']
  aftr_info varchar [note: 'Thông tin hồ sơ sau khi thay đổi (dạng văn bản).']
  doc_ref_nbr varchar [note: 'Số giấy phép/quyết định/công văn liên quan đến thay đổi hồ sơ.']
  efctv_dt date [note: 'Ngày văn bản/thay đổi có hiệu lực.']
  apprvl_doc_ind boolean [note: 'Cờ có văn bản chấp thuận: 1=Có; 0=Không.']
  prfmr_nm varchar [note: 'Tên người thực hiện thay đổi (denormalized snapshot).']
  exctn_tms timestamp [note: 'Thời điểm thực hiện thay đổi hồ sơ.']
  prfmd_by_scms_usr_id varchar [note: 'FK đến người thực hiện thay đổi hồ sơ.']
  prfmd_by_scms_usr_code varchar [note: 'Mã người thực hiện thay đổi hồ sơ.']
}

Table sc_firm_related_person [note: 'Securities Company Related Person'] {
  scr_co_rltd_prsn_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_rltd_prsn_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán mà người liên quan này gắn với.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  ent_tp_code varchar [note: 'Loại đối tượng người liên quan: CA_NHAN=Cá nhân; TO_CHUC=Tổ chức (trong nước/...']
  rcrd_st_code varchar [note: 'Trạng thái bản ghi: 1=Đang hoạt động/còn hiệu lực; 0=Ngừng hoạt động/hết hiệu...']
  gndr_code varchar [note: 'Giới tính: 1=Nam; 2=Nữ.']
  pstn_id varchar [note: 'FK đến danh mục chức vụ của người liên quan.']
  pstn_code varchar [note: 'Mã chức vụ của người liên quan.']
  ctry_id varchar [note: 'FK đến quốc gia của người/tổ chức liên quan.']
  ctry_code varchar [note: 'Mã quốc gia của người/tổ chức liên quan.']
  full_nm varchar [note: 'Họ và tên đầy đủ (cá nhân) hoặc tên đầy đủ (tổ chức).']
  org_nm_en varchar [note: 'Tên tổ chức bằng tiếng Anh.']
  org_shrt_nm varchar [note: 'Tên viết tắt của tổ chức liên quan.']
  dt_of_brth date [note: 'Ngày sinh (dd/mm/yyyy).']
  issue_dt date [note: 'Ngày cấp giấy tờ/chứng chỉ định danh.']
  issue_plc varchar [note: 'Nơi cấp giấy tờ/chứng chỉ định danh.']
  rprsntv_title varchar [note: 'Chức danh người đại diện.']
  lgl_rprsntv varchar [note: 'Thông tin người đại diện pháp luật (lưu dạng text).']
  appntmt_dt date [note: 'Ngày bổ nhiệm vào chức vụ.']
  wkplc varchar [note: 'Nơi làm việc của người liên quan.']
  rltshp varchar [note: 'Mối quan hệ với CTCK hoặc với người nội bộ (vợ/chồng/con cái/anh chị em).']
  ownshp_ratio decimal [note: 'Tỷ lệ sở hữu vốn (%).']
  ownshp_ratio_dt date [note: 'Ngày xác định tỷ lệ sở hữu.']
  shrs_cnt integer [note: 'Số lượng cổ phần nắm giữ.']
  fndng_shrhdr_ind boolean [note: 'Cờ là cổ đông sáng lập: 1=Có; 0=Không.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi (tự động ghi nhận bởi hệ thống).']
  udt_tms timestamp [note: 'Thời điểm cập nhật lần cuối (tự động ghi nhận bởi hệ thống).']
  crt_by_scms_usr_id varchar [note: 'FK đến người tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người tạo bản ghi.']
}

Table sc_firm_related_person_ip_alt_identification [note: 'IP Alt Identification'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Related Person.']
