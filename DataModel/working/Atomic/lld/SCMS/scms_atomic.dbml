  dsc varchar [note: 'Mô tả chi tiết nội dung/mục đích của bản ghi.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  frml_txt varchar [note: 'Mô tả công thức dạng văn bản để hiển thị cho người dùng.']
