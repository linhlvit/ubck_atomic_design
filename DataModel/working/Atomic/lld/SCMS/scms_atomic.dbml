Table sc_firm_insider_relation [note: 'Securities Company Insider Related Person'] {
  scr_co_insdpr_rltd_prsn_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_insdpr_rltd_prsn_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán mà người nội bộ liên quan.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  scr_co_snr_prsnl_id varchar [note: 'FK đến nhân sự cao cấp CTCK mà người này có quan hệ nội bộ.']
  scr_co_snr_prsnl_code varchar [note: 'Mã nhân sự cao cấp liên quan.']
  ent_tp_code varchar [note: 'Loại đối tượng người nội bộ: CA_NHAN=Cá nhân; TO_CHUC=Tổ chức.']
  rcrd_st_code varchar [note: 'Trạng thái bản ghi: 1=Còn hiệu lực; 0=Hết hiệu lực.']
  gndr_code varchar [note: 'Giới tính: 1=Nam; 2=Nữ.']
  full_nm varchar [note: 'Họ và tên đầy đủ (cá nhân) hoặc tên đầy đủ (tổ chức).']
  nm_en varchar [note: 'Tên đầy đủ bằng tiếng Anh.']
  shrt_nm varchar [note: 'Tên viết tắt của tổ chức (VD: SSI, VPS, MBS).']
  dt_of_brth date [note: 'Ngày sinh (dd/mm/yyyy).']
  issue_dt date [note: 'Ngày cấp giấy tờ/chứng chỉ định danh.']
  issue_plc varchar [note: 'Nơi cấp giấy tờ/chứng chỉ định danh.']
  ntlty_id varchar [note: 'FK đến quốc tịch của người nội bộ.']
  ntlty_code varchar [note: 'Mã quốc tịch của người nội bộ.']
  rltshp varchar [note: 'Mối quan hệ với nhân sự cao cấp (vợ/chồng/con cái/anh chị em).']
  rln_strt_dt date [note: 'Ngày bắt đầu mối quan hệ nội bộ.']
  ownshp_ratio decimal [note: 'Tỷ lệ sở hữu vốn (%).']
  ownshp_ratio_dt date [note: 'Ngày xác định tỷ lệ sở hữu.']
  shrs_cnt integer [note: 'Số lượng cổ phần nắm giữ.']
  fndng_shrhdr_ind boolean [note: 'Cờ là cổ đông sáng lập: 1=Có; 0=Không.']
  lgl_rprsntv_nm varchar [note: 'Tên người đại diện pháp luật của tổ chức nội bộ.']
  rprsntv_pstn varchar [note: 'Chức vụ của người đại diện pháp luật.']
  note varchar [note: 'Ghi chú bổ sung về người nội bộ.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
  crt_by_scms_usr_id varchar [note: 'FK đến người tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến người cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người cập nhật bản ghi gần nhất.']
}

