  scr_co_ownshp_rln_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán có quan hệ sở hữu.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  ownshp_rln_tp_code varchar [note: 'Loại quan hệ sở hữu: SO_HUU_TREN_5=Sở hữu trên 5%; CONG_TY_CON=Công ty con; C...']
  co_nm varchar [note: 'Tên tổ chức/công ty có quan hệ sở hữu với CTCK (denormalized).']
  ent_tp_id varchar [note: 'FK đến loại hình doanh nghiệp của tổ chức có quan hệ sở hữu.']
  ent_tp_code varchar [note: 'Mã loại hình doanh nghiệp của tổ chức có quan hệ sở hữu.']
