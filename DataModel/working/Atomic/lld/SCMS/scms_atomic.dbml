Table alert_indicator [note: 'Securities Company Alert Indicator'] {
  scr_co_alrt_ind_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_alrt_ind_code varchar [not null, note: 'Khóa chính kỹ thuật (ID tự tăng). BK của entity.']
