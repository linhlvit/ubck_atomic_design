}

Table sc_firm_rep_office [note: 'Securities Company Organization Unit'] {
  scr_co_org_unt_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_org_unt_code varchar [not null, note: 'Khóa chính kỹ thuật (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  org_unt_tp_code varchar [not null, note: 'Loại đơn vị tổ chức trực thuộc CTCK.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  prn_org_unt_id varchar [note: 'FK đến chi nhánh cha (VPDD có thể trực thuộc chi nhánh hoặc hội sở).']
  prn_org_unt_code varchar [note: 'Mã đơn vị tổ chức cha.']
  org_unt_nm varchar [note: 'Tên văn phòng đại diện.']
  org_unt_lgcy_nm varchar [note: 'Tên văn phòng đại diện (trường OFFICE_NAME — có thể trùng với FULL_NAME).']
  lfc_st_code varchar [note: 'Trạng thái pháp lý văn phòng đại diện: 1=Hoạt động; 2=Đóng cửa; 3=Tạm ngừng; ...']
  rcrd_st_code varchar [note: 'Trạng thái bản ghi kỹ thuật: 1=Còn hiệu lực; 0=Hết hiệu lực.']
  prvsn_ind boolean [note: 'Cờ bản nháp: 1=Bản nháp; 0=Chính thức.']
  evt_tp_code varchar [note: 'Loại sự vụ/sự kiện nghiệp vụ.']
  dcsn_nbr varchar [note: 'Số quyết định cấp phép/chấp thuận văn phòng.']
  dcsn_nbr_sec varchar [note: 'Số quyết định (trường mới DECISION_NUMBER — cần xác nhận trùng với SO_QUYET_D...']
  dcsn_dt date [note: 'Ngày ban hành quyết định.']
  dcsn_dt_sec date [note: 'Ngày quyết định (trường mới DECISION_DATE — cần xác nhận trùng với NGAY_QUYET...']
  doc_nbr varchar [note: 'Số văn bản pháp lý (QĐ/GP/CV/Thông tư).']
  doc_dt date [note: 'Ngày ký/ban hành văn bản.']
  doc_file_path varchar [note: 'Đường dẫn file văn bản.']
  doc_decl_ind boolean [note: 'Cờ khai theo văn bản: 1=Có khai theo văn bản; 0=Không.']
  vld_dssr_dt date [note: 'Ngày hồ sơ hợp lệ.']
  ofcl_oprtn_dt date [note: 'Ngày bắt đầu hoạt động chính thức.']
  vldty_strt_dt date [note: 'Ngày bắt đầu hiệu lực giấy phép/văn bản.']
  vldty_end_dt date [note: 'Ngày hết hiệu lực giấy phép/văn bản.']
  rprs_nm varchar [note: 'Họ tên người đại diện văn phòng.']
  rprs_id varchar [note: 'ID nhân sự người đại diện (liên kết nội bộ SCMS, không phải FK chính thức).']
  scope_of_oprtn varchar [note: 'Phạm vi hoạt động của văn phòng đại diện.']
  attch_path varchar [note: 'Đường dẫn file đính kèm trên hệ thống lưu trữ.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
  crt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
}

Table sc_firm_rep_office_ip_electronic_address [note: 'IP Electronic Address'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Organization Unit (VPDD CTCK nội địa).']
  elec_addr_tp_code varchar [primary key, not null, note: 'Loại địa chỉ điện tử: PHONE=Điện thoại; FAX=Fax.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  elec_addr_val varchar [note: 'Giá trị địa chỉ điện tử (số điện thoại / số fax).']
}

Table sc_firm_rep_office_ip_postal_address [note: 'IP Postal Address'] {
  ip_id varchar [primary key, not null, note: 'FK đến Securities Company Organization Unit (VPDD CTCK nội địa).']
  addr_tp_code varchar [primary key, not null, note: 'Loại địa chỉ: HEAD_OFFICE=Trụ sở/địa điểm VPDD.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  strt_addr varchar [note: 'Địa chỉ chi tiết của VPDD (số nhà, tên đường, phường/xã).']
  prov_geo_area_id varchar [note: 'FK đến Geographic Area cấp Tỉnh/Thành phố.']
  prov_geo_area_code varchar [note: 'Mã Tỉnh/Thành phố.']
  dist_geo_area_id varchar [note: 'FK đến Geographic Area cấp Quận/Huyện.']
  dist_geo_area_code varchar [note: 'Mã Quận/Huyện.']
  ward_geo_area_id varchar [note: 'FK đến Geographic Area cấp Phường/Xã.']
  ward_geo_area_code varchar [note: 'Mã Phường/Xã.']
}

Table sc_firm_senior_personnel [note: 'Securities Company Senior Personnel'] {
  scr_co_snr_prsnl_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_snr_prsnl_code varchar [not null, note: 'Khóa chính kỹ thuật (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  brn_org_unt_id varchar [note: 'FK đến chi nhánh CTCK nơi nhân sự công tác (nullable).']
  brn_org_unt_code varchar [note: 'Mã chi nhánh CTCK nơi nhân sự công tác.']
  txn_ofc_org_unt_id varchar [note: 'FK đến phòng giao dịch CTCK nơi nhân sự công tác (nullable).']
  txn_ofc_org_unt_code varchar [note: 'Mã phòng giao dịch CTCK nơi nhân sự công tác.']
  rp_ofc_org_unt_id varchar [note: 'FK đến VPDD CTCK nơi nhân sự công tác (nullable).']
  rp_ofc_org_unt_code varchar [note: 'Mã VPDD CTCK nơi nhân sự công tác.']
  full_nm varchar [note: 'Họ và tên đầy đủ (cá nhân) hoặc tên đầy đủ (tổ chức).']
  entity_tp_code varchar [note: 'Loại đối tượng: CA_NHAN=Cá nhân; TO_CHUC=Tổ chức.']
  gndr_code varchar [note: 'Giới tính: 1=Nam; 2=Nữ.']
  brth_dt date [note: 'Ngày sinh (dd/mm/yyyy).']
  plc_of_brth varchar [note: 'Nơi sinh.']
  ntlty_code varchar [note: 'Quốc tịch (FK đến CAT_NATIONALITY).']
  prsnl_st_code varchar [note: 'Trạng thái nhân sự cấp cao: DUONG_NHIEM=Đương nhiệm; MIEN_NHIEM=Miễn nhiệm; N...']
  rcrd_st_code varchar [note: 'Trạng thái bản ghi kỹ thuật: 1=Đang hoạt động; 0=Ngừng hoạt động.']
  prvsn_ind boolean [note: 'Cờ bản nháp: 1=Bản nháp; 0=Chính thức.']
  lgl_rprs_ind boolean [note: 'Là người đại diện theo pháp luật: 1=Có; 0=Không.']
  stttry_rprs_ind boolean [note: 'Là người đại diện theo điều lệ.']
  dscsr_prsn_ind boolean [note: 'Là người công bố thông tin (NGUOI_CONG_BO_TT): 1=Có; 0=Không.']
  dscsr_prsn_id varchar [note: 'FK đến người dùng đại diện công bố thông tin (SYS_USER).']
  dscsr_prsn_code varchar [note: 'Mã người dùng đại diện công bố thông tin.']
  dept varchar [note: 'Phòng/Ban công tác của nhân sự.']
  pstn_code varchar [note: 'Mã chức vụ trong danh mục (FK → CAT_POSITION).']
  pstn_nm varchar [note: 'Tên chức vụ (tên tự do, không chuẩn hóa theo danh mục).']
  pstn_ids varchar [note: 'Danh sách ID chức vụ kiêm nhiệm (CLOB — có thể là JSON array).']
  appntmt_dt date [note: 'Ngày bổ nhiệm vào chức vụ.']
  wrk_strt_dt date [note: 'Ngày bắt đầu làm việc tại CTCK.']
  dsmssl_dt date [note: 'Ngày miễn nhiệm khỏi chức vụ.']
  rsgtn_dt date [note: 'Ngày nghỉ việc (tự nguyện).']
  scr_lcns_ind boolean [note: 'Có chứng chỉ hành nghề chứng khoán: 1=Có; 0=Không.']
  scr_lcns_nbr varchar [note: 'Số chứng chỉ hành nghề chứng khoán (CCHN).']
  scr_lcns_dt date [note: 'Ngày cấp chứng chỉ hành nghề chứng khoán.']
  shrhdr_tp_code varchar [note: 'Loại cổ đông: CO_DONG_LON=Cổ đông lớn (≥5%); CO_DONG_SANG_LAP=Cổ đông sáng lậ...']
  cntrtd_cptl_amt decimal(23,2) [note: 'Vốn góp của nhân sự này với tư cách cổ đông (đơn vị: đồng).']
  ownshp_rti_dt date [note: 'Ngày tính tỷ lệ sở hữu.']
  lgcy_prttnr_id varchar [note: 'ID nhân sự từ hệ thống cũ (TLID).']
  biz_div_id varchar [note: 'ID phân khu kinh doanh (FK → không xác định, pending).']
  rspnsbl_svc_id varchar [note: 'ID dịch vụ phụ trách (FK → không xác định, pending).']
  rprt_cntnt varchar [note: 'Nội dung báo cáo liên quan đến nhân sự.']
  dlrd_ind boolean [note: 'Cờ xóa mềm: 1=Đã xóa; 0=Chưa xóa.']
  attch_path varchar [note: 'Đường dẫn file đính kèm.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
  crt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
}

