  amndmt_eff_dt date [note: 'Ngày hiệu lực văn bản sửa đổi.']
  amndmt_doc_file_path varchar [note: 'Đường dẫn file văn bản sửa đổi.']
  prn_co_nm varchar [note: 'Tên công ty mẹ nước ngoài.']
  prn_co_license_nbr varchar [note: 'Số giấy phép hoạt động của công ty mẹ nước ngoài.']
  prn_co_license_dt date [note: 'Ngày cấp giấy phép của công ty mẹ nước ngoài.']
  prn_co_hq_addr varchar [note: 'Địa chỉ trụ sở chính của công ty mẹ nước ngoài.']
  ctry_nm varchar [note: 'Tên quốc gia nơi công ty mẹ đặt trụ sở.']
  rptng_enabled_ind boolean [note: 'Cờ kích hoạt báo cáo định kỳ: 1=Có; 0=Không.']
  syncd_from_adm_proc_ind boolean [note: 'Cờ đồng bộ từ thủ tục hành chính: 1=Đồng bộ từ TTHC; 0=Nhập tay.']
  attch_path varchar [note: 'Đường dẫn file đính kèm.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
  crt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
}

