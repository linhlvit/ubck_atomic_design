Table sc_firm_inspection_schedule [note: 'Securities Company Inspection Schedule'] {
  scr_co_inspctn_schd_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_co_inspctn_schd_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng). BK của entity.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán được kiểm tra/thanh tra.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  inspctn_tp_code varchar [note: 'Loại hoạt động giám sát: KIEM_TRA=Kiểm tra; THANH_TRA=Thanh tra.']
  inspctn_form_tp_code varchar [note: 'Hình thức kiểm tra: DINH_KY=Định kỳ; DOT_XUAT=Đột xuất (từ FORM_TYPE).']
  inspctn_ctgry_code varchar [note: 'Phân loại đợt kiểm tra theo chu kỳ: DINH_KY=Định kỳ; DOT_XUAT=Đột xuất (từ IN...']
  rcrd_st_code varchar [note: 'Trạng thái bản ghi: 1=Đang hoạt động; 0=Ngừng hoạt động.']
  dcn_nbr varchar [note: 'Số hiệu quyết định kiểm tra/thanh tra.']
  dcn_dt date [note: 'Ngày ban hành quyết định kiểm tra/thanh tra.']
  dcn_cntnt varchar [note: 'Nội dung quyết định kiểm tra/thanh tra.']
  strt_dt date [note: 'Ngày bắt đầu thực hiện kiểm tra/thanh tra.']
  end_dt date [note: 'Ngày kết thúc thực hiện kiểm tra/thanh tra.']
  inspctn_from_dt date [note: 'Ngày bắt đầu của giai đoạn được kiểm tra.']
  inspctn_to_dt date [note: 'Ngày kết thúc của giai đoạn được kiểm tra.']
  prd_from_dt date [note: 'Ngày bắt đầu kỳ báo cáo được kiểm tra.']
  prd_to_dt date [note: 'Ngày kết thúc kỳ báo cáo được kiểm tra.']
  team_ldr varchar [note: 'Tên trưởng đoàn kiểm tra/thanh tra.']
  inspctr_nm varchar [note: 'Tên kiểm tra viên.']
  impl_unt varchar [note: 'Đơn vị thực hiện kiểm tra/thanh tra.']
  amt decimal [note: 'Số tiền liên quan đến đợt kiểm tra/thanh tra.']
  cntnt varchar [note: 'Nội dung kế hoạch kiểm tra/thanh tra.']
  cnclsn_smry varchar [note: 'Tóm tắt kết luận kiểm tra/thanh tra.']
  rcmdtns varchar [note: 'Kiến nghị sau kiểm tra/thanh tra.']
  cnclsn_doc_nbr varchar [note: 'Số hiệu văn bản kết luận kiểm tra/thanh tra.']
  cnclsn_doc_dt date [note: 'Ngày ban hành văn bản kết luận.']
  dcn_file_path varchar [note: 'Đường dẫn file quyết định kiểm tra/thanh tra.']
  cnclsn_doc_file_path varchar [note: 'Đường dẫn file văn bản kết luận kiểm tra/thanh tra.']
  attch_path varchar [note: 'Đường dẫn file đính kèm của đợt kiểm tra.']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
  crt_by_scms_usr_id varchar [note: 'FK đến người tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến người cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người cập nhật bản ghi gần nhất.']
}

Table sc_firm_licensed_practitioner [note: 'Securities Practitioner'] {
  scr_prac_id varchar [primary key, not null, note: 'Khóa đại diện (surrogate key).']
  scr_prac_code varchar [not null, note: 'Khóa chính kỹ thuật SCMS (ID tự tăng). BK của entity từ nguồn SCMS.']
  src_stm_code varchar [not null, note: 'Mã hệ thống nguồn dữ liệu.']
  nhnck_prsnl_id varchar [note: 'ID người hành nghề trong hệ thống NHNCK (link đến canonical source).']
  scr_co_id varchar [not null, note: 'FK đến Công ty chứng khoán nơi người hành nghề công tác.']
  scr_co_code varchar [not null, note: 'Mã Công ty chứng khoán.']
  brn_org_unt_id varchar [note: 'FK đến chi nhánh CTCK nơi người hành nghề công tác (nullable).']
  brn_org_unt_code varchar [note: 'Mã chi nhánh.']
  txn_ofc_org_unt_id varchar [note: 'FK đến phòng giao dịch CTCK nơi người hành nghề công tác (nullable).']
  txn_ofc_org_unt_code varchar [note: 'Mã phòng giao dịch.']
  rp_ofc_org_unt_id varchar [note: 'FK đến VPDD CTCK nơi người hành nghề công tác (nullable).']
  rp_ofc_org_unt_code varchar [note: 'Mã VPDD.']
  scr_lcns_nbr varchar [note: 'Số chứng chỉ hành nghề chứng khoán theo SCMS.']
  scr_lcns_dt date [note: 'Ngày cấp chứng chỉ hành nghề chứng khoán.']
  scr_lcns_nbr_sec varchar [note: 'Số chứng chỉ hành nghề chứng khoán (cột thứ 2 — cần xác nhận khác SO_CHUNG_CH...']
  wrk_st_code varchar [note: 'Trạng thái làm việc tại CTCK: DANG_LAM_VIEC=Đang làm việc; DA_NGHI_VIEC=Đã ng...']
  rcrd_st_code varchar [note: 'Trạng thái bản ghi tại CTCK: 1=Đương nhiệm/Đang làm việc; 0=Đã nghỉ việc/Miễn...']
  lcns_st_code varchar [note: 'Trạng thái người hành nghề tại CTCK.']
  vrfctn_st_code varchar [note: 'Trạng thái xác minh CCHN với hệ thống NHNCK: 0=Chờ xác minh; 1=Khớp; 2=Không ...']
  wrk_strt_dt date [note: 'Ngày bắt đầu làm việc tại CTCK.']
  wrk_end_dt date [note: 'Ngày kết thúc làm việc tại CTCK.']
  appntmt_dt date [note: 'Ngày bổ nhiệm vào vị trí.']
  dsmssl_dt date [note: 'Ngày miễn nhiệm.']
  cert_issue_dt date [note: 'Ngày cấp giấy tờ/chứng chỉ.']
  biz_line_code varchar [note: 'Nghiệp vụ kinh doanh người hành nghề phụ trách (FK → CAT_BUSINESS_LINE).']
  biz_div_id varchar [note: 'ID phân khu kinh doanh (pending FK target).']
  rspnsbl_svc_id varchar [note: 'ID dịch vụ phụ trách (pending FK target).']
  syncd_ind boolean [note: 'Cờ đã đồng bộ với hệ thống NHNCK: 1=Đã sync; 0=Chưa sync.']
  sync_tms timestamp [note: 'Thời điểm đồng bộ với hệ thống NHNCK gần nhất.']
  ltst_vrfctn_tms timestamp [note: 'Thời điểm xác minh CCHN với NHNCK gần nhất.']
  insdpr_ind boolean [note: 'Là người nội bộ của CTCK theo quy định CBTT: 1=Người nội bộ; 0=Không phải.']
  lbr_cntrt_trm_rpt_ind boolean [note: 'Đã nộp báo cáo chấm dứt hợp đồng lao động: 1=Đã nộp; 0=Chưa nộp.']
  dlrd_ind boolean [note: 'Cờ xóa mềm: 1=Đã xóa; 0=Chưa xóa.']
  rprt_id varchar [note: 'FK đến biểu mẫu báo cáo liên quan (FORM_REPORT).']
  btch_id varchar [note: 'ID batch xử lý đồng bộ dữ liệu.']
  err_txt varchar [note: 'Nội dung lỗi đồng bộ dữ liệu (nếu có).']
  cntnt varchar [note: 'Nội dung thông báo/tin nhắn liên quan đến người hành nghề.']
  attch_path varchar [note: 'Đường dẫn file đính kèm.']
  note varchar [note: 'Ghi chú bổ sung, không bắt buộc.']
  lgcy_full_nm varchar [note: 'Họ và tên đầy đủ (từ hệ thống cũ — HOTEN).']
  lgcy_gndr_code varchar [note: 'Giới tính từ hệ thống cũ (GIOITINH — text).']
  lgcy_brth_dt date [note: 'Ngày sinh từ hệ thống cũ (NGAY_SINH).']
  lgcy_ntlty varchar [note: 'Quốc tịch (text) từ hệ thống cũ (QUOCTICH).']
  lgcy_plc_of_brth varchar [note: 'Nơi sinh từ hệ thống cũ (NOISINH).']
  lgcy_natl_id_nbr varchar [note: 'Số CMND từ hệ thống cũ (SOCMT).']
  lgcy_id_issue_plc varchar [note: 'Nơi cấp CMND từ hệ thống cũ (NOICAPCMT).']
  lgcy_co_nm varchar [note: 'Tên công ty từ hệ thống cũ (TENCONGTY).']
  lgcy_co_en_nm varchar [note: 'Tên công ty tiếng Anh từ hệ thống cũ (TENTIENGANH).']
  lgcy_co_shrt_nm varchar [note: 'Tên viết tắt công ty từ hệ thống cũ (TENVIETTAT).']
  lgcy_license_nbr varchar [note: 'Số giấy phép từ hệ thống cũ (SOGIAYPHEP).']
  lgcy_dept varchar [note: 'Phòng/Ban từ hệ thống cũ (PHONGBAN).']
  lgcy_pstn varchar [note: 'Chức vụ từ hệ thống cũ (CHUCVU).']
  lgcy_crt_dt date [note: 'Ngày tạo từ hệ thống cũ (DATECREATED).']
  lgcy_crt_by varchar [note: 'Người tạo từ hệ thống cũ (CREATEDBY).']
  lgcy_udt_dt date [note: 'Ngày cập nhật từ hệ thống cũ (DATEMODIFY).']
  lgcy_udt_by varchar [note: 'Người cập nhật từ hệ thống cũ (MODIFYBY).']
  crt_tms timestamp [note: 'Thời điểm tạo bản ghi.']
  udt_tms timestamp [note: 'Thời điểm cập nhật bản ghi gần nhất.']
  crt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS tạo bản ghi.']
  crt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS tạo bản ghi.']
  udt_by_scms_usr_id varchar [note: 'FK đến người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
  udt_by_scms_usr_code varchar [note: 'Mã người dùng hệ thống SCMS cập nhật bản ghi gần nhất.']
}

